# ==============================================================================
# Environment Configuration Template for REGOKEMON Backend
# Salin file ini menjadi .env lalu isi kredensial yang valid:
# cp backend/.env.example backend/.env
# ==============================================================================

# API Key pokemontcg.io (Opsional tapi direkomendasikan untuk menghindari rate-limit)
POKEMONTCG_API_KEY=your_pokemontcg_api_key_here

# Kredensial Supabase Cloud PostgreSQL
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_PW=your_supabase_database_password_here

# Roboflow API Key untuk Model 2 Card Condition Grader (YOLOv8 fallback)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Sumber Input Kamera (0 untuk default webcam, 1/2 untuk kamera eksternal, atau URL DroidCam)
# Contoh DroidCam: http://192.168.1.5:4747/video
CAMERA_SOURCE=0
